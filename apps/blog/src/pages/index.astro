---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../consts';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout title="Blog" description={SITE.description}>
  <header class="blog-hero">
    <p class="blog-hero-badge">
      <span class="blog-hero-badge-dot" aria-hidden="true"></span>
      Flareboard Blog
    </p>
    <h1 class="blog-headline">Analytics on Cloudflare, explained</h1>
    <p class="blog-lead">
      Product updates, privacy-first guides, and comparisons — written for teams shipping on Workers, D1, KV, R2, and Queues.
    </p>
  </header>

  <ul class="blog-list">
    {
      posts.map((post) => (
        <li>
          <a class="blog-card" href={`${import.meta.env.BASE_URL}/${post.id}`}>
            <h2 class="blog-card-title">{post.data.title}</h2>
            <p class="blog-card-desc">{post.data.description}</p>
            <p class="blog-card-meta">
              {formatDate(post.data.pubDate)} · {post.data.author}
            </p>
            {
              post.data.tags.length > 0 && (
                <div class="blog-card-tags">
                  {post.data.tags.map((tag) => (
                    <span class="blog-tag">{tag}</span>
                  ))}
                </div>
              )
            }
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
