# Shared secret for JWT (API) and ingest cache tokens — set via Wrangler in production
APP_SECRET=change-me-in-production

# HMAC secret for POST /api/auth/sso (optional; falls back to APP_SECRET)
SSO_SECRET=

# Comma-separated dashboard origins for API CORS (production)
CORS_ORIGINS=https://app.example.com

# Local dashboard (Vite) — proxy targets
# Dashboard → API worker. Dev: local API. Prod (CF Builds): https://api.your-domain.com
# If omitted in prod on flareboard.dev-style hosts, runtime infers https://api.<dashboard-host>
VITE_API_URL=http://localhost:8788
VITE_INGEST_URL=http://localhost:8787
# Public dashboard origin (OG image, canonical). Prod default: https://flareboard.dev
# VITE_SITE_URL=https://flareboard.dev
# Optional: dogfood analytics on your own dashboard build (omit when forking)
# VITE_TRACKING_WEBSITE_ID=your-website-uuid-from-console

# Legacy / optional
NEXT_PUBLIC_API_URL=http://localhost:8788
