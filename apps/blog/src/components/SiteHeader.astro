---
import { BLOG_BASE, DOCS_BASE, MARKETING_ORIGIN } from '../consts';

type Props = {
  activeNav?: 'blog' | 'docs';
  /** The docs come in Chinese too; the blog is English only. */
  lang?: 'en' | 'zh';
};

const { activeNav, lang = 'en' } = Astro.props;
const zh = lang === 'zh';

const nav = [
  { href: MARKETING_ORIGIN, label: zh ? '首页' : 'Home', key: 'home' },
  { href: `${MARKETING_ORIGIN}/features`, label: zh ? '功能' : 'Features', key: 'features' },
  { href: `${MARKETING_ORIGIN}/compare`, label: zh ? '对比' : 'Compare', key: 'compare' },
  { href: `${MARKETING_ORIGIN}/pricing`, label: zh ? '定价' : 'Pricing', key: 'pricing' },
  { href: BLOG_BASE, label: zh ? '博客' : 'Blog', key: 'blog' },
  { href: zh ? `${DOCS_BASE}/zh` : DOCS_BASE, label: zh ? '文档' : 'Docs', key: 'docs' },
];
---

<header class="landing-nav">
  <div class="landing-nav-inner">
    <a class="shell-brand landing-brand" href={MARKETING_ORIGIN}>
      <span class="brand-logo" style="--brand-logo-size: 26px">
        <img
          class="brand-logo-icon"
          src={`${MARKETING_ORIGIN}/logo.avif`}
          alt=""
          width="26"
          height="26"
        />
        <span class="brand-logo-wordmark">Flareboard</span>
      </span>
    </a>

    <nav class="landing-nav-links shell-links" aria-label="Primary">
      {
        nav.map((item) => (
          <a href={item.href} class:list={['shell-link', { active: activeNav === item.key }]}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="landing-nav-actions shell-nav-end">
      <button type="button" class="theme-toggle" aria-label={zh ? '切换主题' : 'Toggle theme'} id="theme-toggle">
        <span class="theme-toggle-track" aria-hidden="true">
          <span class="theme-toggle-icons">
            <svg class="theme-toggle-sun" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
            </svg>
            <svg class="theme-toggle-moon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
          </span>
          <span class="theme-toggle-thumb" id="theme-toggle-thumb" />
        </span>
      </button>
      <a class="btn btn-ghost btn-sm" href={`${MARKETING_ORIGIN}/login`}>{zh ? '登录' : 'Sign in'}</a>
      <a class="btn btn-primary btn-sm" href={`${MARKETING_ORIGIN}/register`}>{zh ? '免费开始' : 'Get started'}</a>
    </div>
  </div>
</header>

<script>
  function syncThemeToggle() {
    const root = document.documentElement;
    const btn = document.getElementById('theme-toggle');
    const thumb = document.getElementById('theme-toggle-thumb');
    const isDark = root.getAttribute('data-theme') === 'dark';
    btn?.classList.toggle('is-dark', isDark);
    thumb?.classList.toggle('is-dark', isDark);
  }

  syncThemeToggle();

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('flareboard-theme', next);
    } catch {
      /* ignore */
    }
    syncThemeToggle();
  });
</script>
