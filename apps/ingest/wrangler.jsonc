{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "flareboard-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat_v2"],
  // Monorepo workspace packages — helps Wrangler resolve when node_modules links are missing
  "alias": {
    "@flareboard/rate-limiter": "../../packages/rate-limiter/src/index.ts",
    "@flareboard/shared": "../../packages/shared/src/index.ts",
    "@flareboard/db": "../../packages/db/src/index.ts"
  },
  "vars": {
    "ENVIRONMENT": "development",
    // Local fallback for fetchApi (src/lib/api-client.ts); production uses the `API` service binding.
    "API_URL": "http://localhost:8788",
    // Analytics storage mode, see @flareboard/db/site-store: d1 | dual | do.
    "EVENT_STORE": "do"
  },
  "dev": {
    "port": 8787
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flareboard-db",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "00000000-0000-0000-0000-000000000002"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENT_QUEUE",
        "queue": "flareboard-events"
      },
      {
        // Workflow triggers, consumed and executed by the API worker.
        "binding": "WORKFLOW_QUEUE",
        "queue": "flareboard-workflow-triggers"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      },
      // Per-website analytics stores live in the API worker (deploy the API first).
      {
        "name": "SITE_STORE",
        "class_name": "EventStore",
        "script_name": "flareboard-api"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-rate-limiter",
      "new_sqlite_classes": ["RateLimiter"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "REPLAY_BUCKET",
      "bucket_name": "flareboard-replays"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "env": {
    "production": {
      "vars": {
        "ENVIRONMENT": "production",
        "HOSTED_MODE": "true",
        // Switch to "dual", backfill, verify, then "do" (docs/parity/storage-migration.md).
        "EVENT_STORE": "dual"
      },
      // fetchApi calls the API worker in-network (no public hop, no WAF challenge).
      "services": [
        {
          "binding": "API",
          "service": "flareboard-api-production"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "flareboard-db",
          "database_id": "d722f47e-8fd8-4414-8994-8fd73001a9b1",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "8db5ae0c6ed9492ca9e591f02bc56727"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "EVENT_QUEUE",
            "queue": "flareboard-events"
          },
          {
            "binding": "WORKFLOW_QUEUE",
            "queue": "flareboard-workflow-triggers"
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "RATE_LIMITER",
            "class_name": "RateLimiter"
          },
          {
            "name": "SITE_STORE",
            "class_name": "EventStore",
            "script_name": "flareboard-api-production"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1-rate-limiter",
          "new_sqlite_classes": ["RateLimiter"]
        }
      ],
      "r2_buckets": [
        {
          "binding": "REPLAY_BUCKET",
          "bucket_name": "flareboard-replays"
        }
      ],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "invocation_logs": true,
          "head_sampling_rate": 1
        }
      }
    }
  }
}
