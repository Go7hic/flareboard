---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHead from '../components/SiteHead.astro';
import { BLOG_BASE, SITE } from '../consts';

type Props = {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  pubDate?: Date;
  author?: string;
};

const {
  title,
  description = SITE.description,
  ogType = 'website',
  pubDate,
  author,
} = Astro.props;

const pageTitle = title ? `${title} - Flareboard Blog` : SITE.title;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead title={pageTitle} description={description} ogType={ogType}>
      <link rel="alternate" type="application/rss+xml" title="Flareboard Blog" href={`${BLOG_BASE}/rss.xml`} />
      {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
      {author && <meta property="article:author" content={author} />}
    </SiteHead>
  </head>
  <body>
    <div class="landing">
      <SiteHeader activeNav="blog" />
      <main class="page">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
