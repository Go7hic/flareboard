{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "flareboard-aggregator",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat_v2"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flareboard-db",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "flareboard-events-dlq",
        "binding": "DLQ"
      }
    ],
    "consumers": [
      {
        "queue": "flareboard-events",
        "max_batch_size": 50,
        "max_batch_timeout": 2,
        // Matches MAX_RETRIES in src/index.ts so the logged dead-letter path runs.
        "max_retries": 5,
        "dead_letter_queue": "flareboard-events-dlq"
      },
      {
        "queue": "flareboard-events-dlq",
        "max_batch_size": 50,
        "max_batch_timeout": 30
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  // Analytics storage mode, see @flareboard/db/site-store: d1 | dual | do.
  "vars": {
    "EVENT_STORE": "do"
  },
  // Per-website analytics stores live in the API worker (deploy the API first).
  "durable_objects": {
    "bindings": [
      {
        "name": "SITE_STORE",
        "class_name": "EventStore",
        "script_name": "flareboard-api"
      }
    ]
  },
  "env": {
    "production": {
      "vars": {
        "HOSTED_MODE": "true",
        // Switch to "dual", backfill, verify, then "do" (docs/parity/storage-migration.md).
        "EVENT_STORE": "d1"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "SITE_STORE",
            "class_name": "EventStore",
            "script_name": "flareboard-api-production"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "flareboard-db",
          "database_id": "d722f47e-8fd8-4414-8994-8fd73001a9b1",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "queues": {
        "producers": [
          {
            "queue": "flareboard-events-dlq",
            "binding": "DLQ"
          }
        ],
        "consumers": [
          {
            "queue": "flareboard-events",
            "max_batch_size": 50,
            "max_batch_timeout": 2,
            "max_retries": 5,
            "dead_letter_queue": "flareboard-events-dlq"
          },
          {
            "queue": "flareboard-events-dlq",
            "max_batch_size": 50,
            "max_batch_timeout": 30
          }
        ]
      }
    }
  }
}
